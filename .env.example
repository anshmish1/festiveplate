# Copy to .env and fill in what you have. EVERYTHING is optional for a local demo:
# missing integrations run in clearly-labelled DEMO / NOT CONFIGURED mode.
# Never commit .env. These values are read by the backend only - none reach the browser.

# --- Core ---
APP_ENV=development                  # set to "production" to enforce JWT_SECRET and stricter defaults
DATABASE_URL=sqlite:///./festiveplate.db   # docker-compose overrides this with Postgres
JWT_SECRET=                          # REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_EXPIRE_MINUTES=240
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=./uploads
SEED_DEMO_DATA=true                  # docker only: seed labelled demo accounts on start

# --- Sarvam AI (speech-to-text, translation, extraction) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_CHAT_MODEL=sarvam-m

# --- Flagsmith (feature flags; safe defaults used when absent) ---
FLAGSMITH_ENVIRONMENT_KEY=           # server-side environment key
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# --- NudgeBee (AI SRE / observability) ---
NUDGEBEE_ENABLED=false
NUDGEBEE_WEBHOOK_URL=
NUDGEBEE_API_KEY=
METRICS_TOKEN=                       # if set, /metrics requires "Authorization: Bearer <token>"

# --- Docker compose ---
POSTGRES_PASSWORD=festiveplate-local
